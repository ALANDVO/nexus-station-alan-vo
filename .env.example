# Nexus Station — environment configuration
# Copy to .env and fill in real values for production use.

# Database
DATABASE_URL=sqlite:///./nexus_station.db

# Auth mode: "local" (demo) or "production" (requires OIDC)
AUTH_MODE=local

# Local demo API key (change in production)
LOCAL_API_KEY=change-me-in-production

# OIDC configuration (required when AUTH_MODE=production)
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

# LLM provider configuration (optional, for advisory explanations — future milestone)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-3.5-turbo
LLM_BASE_URL=

# Server
HOST=127.0.0.1
PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000